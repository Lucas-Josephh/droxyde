# =========================================================================
# Public API URL — visible in the browser (must be the full https URL in prod)
# =========================================================================
NEXT_PUBLIC_API_URL=http://localhost:4000

# =========================================================================
# Server-side only — used by Next.js Route Handlers / Server Components
# to call the API directly (skip the public network). Usually identical to
# NEXT_PUBLIC_API_URL.
# =========================================================================
API_INTERNAL_URL=http://localhost:4000
