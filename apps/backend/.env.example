# =========================================================================
# Database (Supabase PostgreSQL)
# - DATABASE_URL points to the pooled connection (port 6543, ?pgbouncer=true)
# - DIRECT_URL is required by Prisma Migrate (direct connection, port 5432)
# Get both from Supabase: Project Settings → Database → Connection string
# =========================================================================
DATABASE_URL="postgresql://postgres.xxxxx:[PASSWORD]@aws-0-eu-west-3.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.xxxxx:[PASSWORD]@aws-0-eu-west-3.pooler.supabase.com:5432/postgres"

# =========================================================================
# Server
# =========================================================================
NODE_ENV=development
PORT=4000

# =========================================================================
# Auth — sessions (DB) + httpOnly cookie
# - SESSION_SECRET: long random string (e.g. `openssl rand -hex 64`)
# - SESSION_COOKIE_NAME: name of the cookie carrying the session id
# - SESSION_TTL_DAYS: how long sessions live before expiring
# =========================================================================
SESSION_SECRET="change-me-with-openssl-rand-hex-64"
SESSION_COOKIE_NAME=droxyde.sid
SESSION_TTL_DAYS=30

# =========================================================================
# CORS / Cookies (cross-domain prod, lax local)
# - FRONTEND_URL: full URL of the Next.js app (used for CORS + redirects)
# - COOKIE_DOMAIN: leave empty in local. In prod it depends on your setup:
#     * If front and back are on DIFFERENT root domains (vercel.app vs onrender.com)
#       → leave EMPTY so cookie is set on the API host with SameSite=None.
#     * If they share a root domain → set ".yourdomain.com"
# =========================================================================
FRONTEND_URL=http://localhost:3000
COOKIE_DOMAIN=
